# Скопируйте в .env (в корень репозитория или в backend/) и заполните при необходимости.
# Без этого файла всё работает: подборка реальных новостей + анализ на правилах.

# --- набор данных ---
# real — 5 реальных компаний и подборка реальных публикаций со ссылками (по умолчанию)
# synthetic — вымышленные компании и события (на них построены тесты бизнес-логики)
DATASET=real

# --- LLM (необязательно): только шесть моделей, разрешённых кейсом (docs/COMPLIANCE.md) ---
# off     — без LLM: правила и свои ML-модели (по умолчанию)
# mock    — мок-режим шлюза: ответы в формате шлюза без сети и ключа (разработка, тесты, демонстрация без ключа)
# gateway — шлюз организаторов; формат API не подтверждён — допущения в docs/GATEWAY_QUESTIONS.md
LLM_PROVIDER=off
LLM_BASE_URL=
# ключ — только здесь; в git, логи, ответы API и Docker-образ не попадает
LLM_API_KEY=
LLM_API_FORMAT=chat_completions
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer
# имена моделей у шлюза, если отличаются от названий кейса (должны узнаваться как та же модель):
# LLM_NAME_GLM_5_3_FLASH=glm-5.3-flash
# LLM_NAME_GEMMA_4_26B_A4B=gemma-4-26b-a4b
# маршруты по типам задач (основная,запасная) — по умолчанию см. страницу «Расход» и app/llm_router.py:
# LLM_ROUTE_ANALYSIS=GLM-5.3-Flash,Qwen3.6 35B A3B
LLM_MODEL_DEFAULT=Qwen3.6 35B A3B
LLM_MODEL_FAST=Gemma 4 26B A4B
LLM_MODEL_REASONING=GLM-5.3-Flash
# мультимодальная модель для распознавания PDF банка (scripts/ocr_bank_docs.py --engine vl)
LLM_MODEL_VISION=Qwen3-VL-30B-A3B-Instruct
# бюджет: лимит кейса — эквивалент 500 ₽ в день; держим ниже (жёстко не выше 499)
LLM_DAILY_BUDGET_RUB=450
LLM_DAILY_TOKEN_LIMIT=300000
# цены — допущение, ₽ за 1 млн токенов «вход,выход»; для модели: LLM_PRICE_GLM_5_3_FLASH=80,240
LLM_PRICE_DEFAULT=60,180
LLM_TIMEOUT=60
LLM_RETRIES=2
LLM_BACKOFF=1.0
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=2000
# мок: сбой модели для проверки запасной, например GLM-5.3-Flash:429;Gemma 4 26B A4B:timeout
# LLM_MOCK_FAIL=
# закрепить версию промпта (по умолчанию — последняя): PROMPT_AGENT_ANSWER=v1
# NER natasha (не LLM); 0 — выключить
NER_ENABLED=1

# --- данные кейса (не коммитятся) ---
# папка с df_Uid_data_hack.csv, df_Uid_payment_hack.csv, df_Fid_Uid_link_hack.csv;
# пусто — ищем в корне репозитория, иначе синтетический пример backend/data/clients/sample
CLIENT_DATA_DIR=
# аналитические материалы Альфа-Банка (PDF, TXT, MD) для RAG; по умолчанию backend/data/bank
BANK_DOCS_DIR=

# --- RSS ---
RSS_TIMEOUT=8
RSS_MAX_ITEMS=30
# сколько раз повторять запрос при сетевой ошибке / 5xx (4xx не повторяем)
RSS_RETRIES=1

# --- Альфа-Банк (доступа нет, коннектор-заготовка) ---
ALFA_NEWS_API_URL=
ALFA_NEWS_API_TOKEN=

# --- добавление компании по ИНН (необязательно) ---
# Без ключа ИНН ищется в публичном поиске ЕГРЮЛ (egrul.nalog.ru): название, регион, ОГРН.
# С ключом DaData (бесплатный тариф) — ещё и основной ОКВЭД, по нему точнее определяется отрасль.
DADATA_API_KEY=

# --- прочее ---
# DB_PATH=backend/alpha.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
