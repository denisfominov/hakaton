diff --git a/frontend/src/pages/LoginPage.tsx b/frontend/src/pages/LoginPage.tsx
new file mode 100644
index 0000000..d678041
--- /dev/null
+++ b/frontend/src/pages/LoginPage.tsx
@@ -0,0 +1,52 @@
+import { useState, type FormEvent } from "react";
+import { login } from "../api";
+import type { Session } from "../session";
+import { texts } from "../texts";
+
+type Props = { onLogin: (session: Session) => void };
+
+export function LoginPage({ onLogin }: Props) {
+  const [name, setName] = useState("");
+  const [password, setPassword] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const submit = async (event: FormEvent) => {
+    event.preventDefault();
+    setBusy(true);
+    setError(null);
+    try {
+      onLogin(await login(name.trim(), password));
+    } catch (e) {
+      setError(e instanceof Error && e.message.startsWith("401") ? texts.login.wrong : texts.login.failed);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="login-page">
+      <form className="login-card" onSubmit={submit}>
+        <div className="brand">
+          <span className="brand-logo">{texts.brand.charAt(0)}</span>
+          <span>{texts.brand}</span>
+        </div>
+        <h2>{texts.login.title}</h2>
+        <p className="muted">{texts.login.subtitle}</p>
+        <label>
+          {texts.login.login}
+          <input value={name} onChange={(e) => setName(e.target.value)} autoComplete="username" autoFocus />
+        </label>
+        <label>
+          {texts.login.password}
+          <input type="password" value={password} onChange={(e) => setPassword(e.target.value)}
+            autoComplete="current-password" />
+        </label>
+        {error && <p className="error-text">{error}</p>}
+        <button className="login-submit" disabled={busy || !name.trim() || !password}>
+          {busy ? texts.login.checking : texts.login.submit}
+        </button>
+      </form>
+    </div>
+  );
+}
diff --git a/frontend/src/session.ts b/frontend/src/session.ts
new file mode 100644
index 0000000..8700c72
--- /dev/null
+++ b/frontend/src/session.ts
@@ -0,0 +1,27 @@
+import type { CompanySummary } from "./api";
+
+export type Account = { login: string; name: string; role: string; group_id: string; companies: CompanySummary[] };
+
+export type Session = { token: string; user: Account };
+
+export const SESSION_EXPIRED = "insights:session-expired";
+
+const KEY = "insights.session";
+
+export function loadSession(): Session | null {
+  try {
+    const value = JSON.parse(localStorage.getItem(KEY) ?? "null");
+    return value && typeof value.token === "string" && value.user ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+export function saveSession(session: Session | null) {
+  try {
+    if (session) localStorage.setItem(KEY, JSON.stringify(session));
+    else localStorage.removeItem(KEY);
+  } catch {
+    return;
+  }
+}
