@@ -0,0 +1,43 @@
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from backend.auth import guard
+from backend.auth.accounts import issue_token
+from backend.config import get_settings
+
+
+@pytest.fixture
+def client(monkeypatch):
+    monkeypatch.setattr(get_settings(), "auth_required", True)
+    monkeypatch.setattr(guard, "insight_company", {"i_own": "U_57706", "i_other": "U_63531"}.get)
+    app = FastAPI()
+    app.middleware("http")(guard.require_login)
+    for path in ("/api/health", "/api/companies", "/api/companies/{uid}/feed", "/api/insights/{insight_id}/card"):
+        app.add_api_route(path, lambda: {"ok": True})
+    return TestClient(app)
+
+
+def bearer(login):
+    return {"Authorization": f"Bearer {issue_token(login)}"}
+
+
+def test_open_paths_and_login_required(client):
+    assert client.get("/api/health").status_code == 200
+    assert client.get("/api/companies").status_code == 401
+    assert client.get("/api/companies", headers={"Authorization": "Bearer forged"}).status_code == 401
+    assert client.get("/api/companies", headers=bearer("demo-ceo")).status_code == 200
+
+
+def test_only_own_companies_and_their_insights(client):
+    headers = bearer("demo-ceo")
+    assert client.get("/api/companies/U_57706/feed", headers=headers).status_code == 200
+    assert client.get("/api/companies/U_63531/feed", headers=headers).status_code == 403
+    assert client.get("/api/insights/i_own/card", headers=headers).status_code == 200
+    assert client.get("/api/insights/i_other/card", headers=headers).status_code == 403
+    assert client.get("/api/insights/i_missing/card", headers=headers).status_code == 200
+
+
+def test_guard_can_be_switched_off(client, monkeypatch):
+    monkeypatch.setattr(get_settings(), "auth_required", False)
+    assert client.get("/api/companies/U_63531/feed").status_code == 200
