@@ -0,0 +1,37 @@
+import re
+from contextlib import closing
+
+from fastapi.responses import JSONResponse
+from starlette.concurrency import run_in_threadpool
+
+from backend.analysis import storage
+from backend.auth.accounts import read_token
+from backend.config import get_settings
+
+OPEN_PATHS = {"/api/health", "/api/auth/login"}
+COMPANY_PATH = re.compile(r"^/api/companies/([^/]+)")
+INSIGHT_PATH = re.compile(r"^/api/insights/([^/]+)")
+
+
+def insight_company(insight_id):
+    with closing(storage.connect()) as conn:
+        row = storage.get_insight(conn, insight_id)
+    return row["company_uid"] if row else None
+
+
+async def require_login(request, call_next):
+    path = request.url.path
+    if not get_settings().auth_required or not path.startswith("/api/") or path in OPEN_PATHS:
+        return await call_next(request)
+    scheme, _, token = request.headers.get("authorization", "").partition(" ")
+    user = read_token(token) if scheme.lower() == "bearer" else None
+    if user is None:
+        return JSONResponse({"detail": "login required"}, status_code=401, headers={"WWW-Authenticate": "Bearer"})
+    uid = None
+    if company := COMPANY_PATH.match(path):
+        uid = company.group(1)
+    elif insight := INSIGHT_PATH.match(path):
+        uid = await run_in_threadpool(insight_company, insight.group(1))
+    if uid is not None and uid not in user.companies:
+        return JSONResponse({"detail": "no access to this company"}, status_code=403)
+    return await call_next(request)
